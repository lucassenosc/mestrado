* text=auto

# Text files: normalize line endings to LF
*.md text eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.zip binary
*.npy binary
*.npz binary
*.pkl binary
*.pickle binary
*.joblib binary
